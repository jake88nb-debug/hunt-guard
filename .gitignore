# ---------------------------------------------------------------
# 运行时数据 —— 绝对不能进仓库
# ---------------------------------------------------------------
# data/ 里全是本机运行时产物：规则副本、事件库、证书私钥、
# 探测到的本机路径。含私钥和用户名，提交上去既没用又不安全。
data/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------
# 编辑器 / IDE
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------
# 临时与调试产物
# ---------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej

# 用户自己的规则备份 / 覆盖配置（本机产物，不进仓库）
rules.local.json
config.local.json
data.bak/

# 发布打包产物（scripts/make-release.sh 的输出）
dist/

# 临时验证脚本与其输出（调试过程中产生的，不属于产品）
_*.py
_*.txt
test_out*.txt
test*_status.txt
verify*.py
verify*.txt
verify*_result.txt
*_result.txt
bypass_check*.txt
git_info.txt
mtimes.txt
pub_check*.txt
final_status.txt
st.txt
